table FactRealisatie
	lineageTag: b0000006-0000-0000-0000-000000000001

	column Datum
		dataType: dateTime
		formatString: Long Date
		summarizeBy: none
		sourceColumn: Datum
		lineageTag: b0000006-0000-0000-0000-000000000002

	column RondeKey
		dataType: string
		summarizeBy: none
		sourceColumn: RondeKey
		lineageTag: b0000006-0000-0000-0000-000000000003

	column LaatsteScanTijd
		dataType: dateTime
		formatString: Long Time
		summarizeBy: none
		sourceColumn: LaatsteScanTijd
		lineageTag: b0000006-0000-0000-0000-000000000004

	column WerkelijkEindUur
		dataType: dateTime
		formatString: Long Time
		summarizeBy: none
		sourceColumn: WerkelijkEindUur
		lineageTag: b0000006-0000-0000-0000-000000000005

	column GerealiseerdPakketten
		dataType: int64
		summarizeBy: none
		sourceColumn: GerealiseerdPakketten
		lineageTag: b0000006-0000-0000-0000-000000000006

	column GerealiseerdBussen
		dataType: int64
