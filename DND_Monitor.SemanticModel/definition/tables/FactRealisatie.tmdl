		lineageTag: b0000006-0000-0000-0000-000000000008

	partition FactRealisatie = m
		mode: import
		source =
				let
				    Bron = Folder.Files(RealisatieFolder & "pod"),
				    #"Enkel csv" = Table.SelectRows(Bron, each Text.EndsWith([Name], ".csv")),
				    #"Bestanden ingelezen" = Table.AddColumn(#"Enkel csv", "Data", each Table.PromoteHeaders(Csv.Document([Content], [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true])),
				    Gecombineerd = Table.Combine(#"Bestanden ingelezen"[Data]),
				    #"Type gewijzigd" = Table.TransformColumnTypes(Gecombineerd,{
				        {"Datum", type date}, {"RondeKey", type text}, {"LaatsteScanTijd", type time},
				        {"WerkelijkEindUur", type time}, {"GerealiseerdPakketten", Int64.Type},
				        {"GerealiseerdBussen", Int64.Type}, {"UitgesteldeStukken", Int64.Type}
				    })
				in
				    #"Type gewijzigd"

	annotation PBI_ResultType = Table

